# ============================================================
# Efish 项目自定义规则
# ============================================================

# 根目录开发/调试过程中产生的临时文件（仅忽略工程根，不影响子目录）
/*.png
/*.jpg
/*.jpeg
/*.gif
/*.py
/*.txt
/*.ps1
/*.bak
/*.tmp

# 数据库备份文件
*.bak.db
assets/words.seed.bak.db

# Windows 构建时自动生成的文件（flutter pub get / build 会重新生成）
windows/flutter/ephemeral/
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake

# 开发过程中的临时工作目录
/Efish_Companion_v1/
/Efish_Companion_v2/
/issue_shots/
